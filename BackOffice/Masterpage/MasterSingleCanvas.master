<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterSingleCanvas.master.cs"
    Inherits="Masterpage_MasterSingleCanvas" %>

<%@ Register Src="ProgramNameControl.ascx" TagName="ProgramNameControl" TagPrefix="uc4" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<%--<%@ Register Src="ProgramControl.ascx" TagName="ProgramControl" TagPrefix="uc3" %>--%>
<%@ Register Src="SiteMapMenu.ascx" TagName="SiteMapMenu" TagPrefix="SiteMapMenu" %>
<%@ Register Src="HeaderControl.ascx" TagName="HeaderControl" TagPrefix="HeaderControl" %>
<%@ Register Src="FooterControl.ascx" TagName="FooterControl" TagPrefix="FooterControl" %>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Master Single Canvas</title>
    <meta http-equiv="Content-Type" content="text/html; charset=windows-874" />
    <link href="../../App_Themes/Blue/style/controls.css" rel="stylesheet" type="text/css" />
    <link href="../../App_Themes/Blue/style/masterpage.css" rel="stylesheet" type="text/css" />
    <link href="../../App_Themes/Blue/style/Sitemap.css" rel="stylesheet" type="text/css" />
    <link href="../../App_Themes/Blue/style/style.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="../Include/scripts/javascript.js"></script>
    <script type="text/javascript" src="../Include/scripts/IncludeScripts.js"></script>
    <script type="text/javascript">        includeScripts('', true, '5502', 'en_US');</script>
    <style type="text/css">
        @import url("../Include/style/calendar.css");
    </style>
    <style type="text/css">
        @import url("../Include/style/style.css");
    </style>
    <style type="text/css">
        .modalBackground
        {
            background-color: #FFFFFF;
            filter: alpha(opacity=70);
            opacity: 0.7;
        }
        .modalPopup
        {
            background-color: #FFFFFF;
            border-width: 3px;
            border-style: solid;
            border-color: Gray;
            padding: 3px;
            width: 250px;
        }
        .updateProgress
        {
            border-width: 1px;
            border-style: solid;
            background-color: #FFFFFF;
            position: absolute;
            width: 130px;
            height: 50px;
        }
        .updateProgressMessage
        {
            margin: 3px;
            font-family: Trebuchet MS;
            font-size: small;
            vertical-align: middle;
        }
    </style>
    <link href="../include/scripts/jQuery/css/custom-theme/jquery-ui-1.10.3.custom.css"
        rel="stylesheet" type="text/css" />
    <script src="../include/scripts/jQuery/jquery-1.9.1.js" type="text/javascript"></script>
    <script src="../include/scripts/jQuery/jquery-ui-1.10.3.custom.js" type="text/javascript"></script>
    <script language="javascript" type="text/javascript">

        function onCloseMenu() {
            var sitemap = document.getElementById("sitemap");
            var style = sitemap.getAttribute("style");
            if (style.display == "none") {
                style.display = "block";
            } else {
                style.display = "none";
            }
        }

        function confirmingVersion(oldUrl, newUrl, newLoginUrl, newReportPage, username) {
            $("#confirmDialog").dialog({
                width: 600,
                height: 200,
                modal: true,
                resizable: false,
                position: [200, 200],
                buttons: {
                    OK: function () {
                        var url = newUrl + '/' + newLoginUrl + '?username=' + username + '&redirectTo=' + newReportPage;

                        window.open(url, '_blank');
                        $(this).dialog("close");
                    },
                    CANCEL: function () {
                        window.location = oldUrl;
                        $(this).dialog("close");
                    }
                }
            });
        }
    </script>
</head>
<body leftmargin="0" topmargin="0" marginwidth="0" marginheight="0">
    <form id="FromMain" runat="server">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" align="center">
        <tr>
            <td>
                <HeaderControl:HeaderControl ID="HeaderControl1" runat="server" />
            </td>
        </tr>
        <tr>
            <td>
                <br />
                <table width="99%" border="0" cellpadding="0" cellspacing="0" align="center">
                    <tr>
                        <td width="9" align="left" valign="top" class="body-lefttopcorner">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                        <td class="body-toptile">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                        <td width="9" align="right" valign="top" class="body-righttop">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                    </tr>
                    <tr>
                        <td align="left" class="body-lefttile">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                        <td height="100%" align="center" valign="top">
                            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="left" valign="top" height="100%" id="sitemap" style="display: block">
                                        <table width="170" border="0" cellspacing="0" cellpadding="0" height="100%">
                                            <tr>
                                                <td align="left" valign="top">
                                                    <SiteMapMenu:SiteMapMenu ID="ProgramControl1" runat="server" />
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td width="1">
                                    </td>
                                    <td class="header-tab" width="10" background="../include/images/tab/bg-tab-center.gif">
                                        <img src="../../App_Themes/Blue/images/masterpage/center-tab-center.gif" onclick="onCloseMenu()"
                                            style="cursor: hand">
                                    </td>
                                    <td width="2">
                                    </td>
                                    <td width="100%" align="right" valign="top">
                                        <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td valign="top" height="100%">
                                                    <table border="0" cellpadding="0" cellspacing="5" class="header-content" height="100%"
                                                        width="100%">
                                                        <tr>
                                                            <td align="left" valign="top">
                                                                <table border="0" cellpadding="4" cellspacing="5" height="100%" width="100%">
                                                                    <tr height="20" valign="top">
                                                                        <td rowspan="2">
                                                                            <uc4:ProgramNameControl ID="ProgramNameControl1" runat="server" />
                                                                        </td>
                                                                    </tr>
                                                                    <tr height="20" valign="top">
                                                                    </tr>
                                                                    <tr id="mainProgram" align="center" valign="top">
                                                                        <td>
                                                                            <table border="0" cellpadding="0" cellspacing="0" height="100%" width="98%">
                                                                                <tr>
                                                                                    <td align="center" class="program-content" height="100%" valign="top">
                                                                                        <asp:ContentPlaceHolder ID="ContentPlaceHolder" runat="server">
                                                                                        </asp:ContentPlaceHolder>
                                                                                    </td>
                                                                                </tr>
                                                                            </table>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td align="right" class="body-righttile">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                    </tr>
                    <tr>
                        <td align="left" valign="bottom" class="body-leftbottomcorner">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                        <td class="body-bottomtile">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                        <td align="right" valign="bottom" class="body-rightbottomcorner">
                            <img src="../include/images/spacer.gif" width="1" height="1">
                        </td>
                    </tr>
                </table>
                <br />
            </td>
        </tr>
        <tr>
            <td>
                <FooterControl:FooterControl ID="FooterControl" runat="server" />
            </td>
        </tr>
    </table>
    <div id="confirmDialog" title="Report available in new DW System" style="font-size: 13px;
        display: none;">
        Please be informed that this report has been redeveloped and deployed to the new
        Data Warehouse System with more user-friendly interface and data accurary. Besides,
        this report will not be offered in this system after
        <label style="font-weight: bold; color: Red;">
            15/07/2013</label>. Kindly click the OK button to use this report in the new
        Data Warehouse System or click the CANCEL button to stay with this system.
    </div>
    </form>
    <!-- Piwik -->
        <script type="text/javascript">
            var _paq = _paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "https://pw.detecas.com/";
                _paq.push(['setTrackerUrl', u + 'piwik.php']);
                _paq.push(['setSiteId', 33]);
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
            })();
            </script>
            <noscript><p><img src="https://pw.detecas.com/piwik.php?rec=1&idsite=33" style="border:0;" alt="" /></p></noscript>
        <!--/ Piwik -->
</body>
</html>
<script language="javascript" type="text/javascript">
    var mainProgram = document.getElementById("mainProgram");
    mainProgram.height = screen.height - 115;
    var sitemap = document.getElementById("sitemap");
    var style = sitemap.getAttribute("style");
</script>
