  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <!--<httpRuntime executionTimeout="1200"/>-->
    <httpRuntime executionTimeout="999999" maxRequestLength="1024000"/>
    <sessionState cookieless="false" timeout="360000"/>
    <!--<customErrors mode="On" defaultRedirect="~/ErrorPage.aspx">
      <error statusCode="404" redirect="~/ErrorPages/FileNotFound.aspx"/>
    </customErrors>-->
    <customErrors mode="Off"/>
    <globalization enableClientBasedCulture="true" culture="Auto" uiCulture="Auto"/>
    <pages styleSheetTheme="Blue" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
      <controls>
        <add tagPrefix="ajax" namespace="Microsoft.Web.UI" assembly="Microsoft.Web.Extensions, Version=1.0.61025.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
        <add tagPrefix="ajax" namespace="Microsoft.Web.UI.Controls" assembly="Microsoft.Web.Extensions, Version=1.0.61025.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
        <add tagPrefix="ajax" namespace="Microsoft.Web.Preview.UI" assembly="Microsoft.Web.Preview"/>
        <add tagPrefix="ajax" namespace="Microsoft.Web.Preview.UI.Controls" assembly="Microsoft.Web.Preview"/>
        <add tagPrefix="ajaxToolkit" namespace="AjaxControlToolkit" assembly="AjaxControlToolkit"/>
      </controls>
    </pages>
    <compilation debug="true" targetFramework="4.5">
      <assemblies>
        <add assembly="Microsoft.Web.Extensions, Version=1.0.61025.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
        <add assembly="Microsoft.Office.Interop.Excel, Version=11.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c"/>
      </assemblies>
    </compilation>
    <authentication mode="Forms">
      <forms loginUrl="~/BackOffice/Login.aspx" name=".ASPXFORMSAUTH" defaultUrl="~/BackOffice/Default.aspx" timeout="1440"/>
    </authentication>
    <membership defaultProvider="FWUserProvider">
      <providers>
        <clear/>
        <add name="FWUserProvider" connectionStringName="FWConnectionString" applicationName="/FWBO" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="true" requiresUniqueEmail="true" passwordFormat="Clear" type="System.Provider.FWUserProvider"/>
      </providers>
    </membership>
    <!--<roleManager defaultProvider="FWRoleProvider" enabled="true" cacheRolesInCookie="true" cookieName=".ASPROLES" cookieTimeout="30" cookiePath="/" cookieRequireSSL="false" cookieSlidingExpiration="true" cookieProtection="All">
      <providers>
        <clear/>
        <add name="FWRoleProvider" connectionStringName="FWConnectionString" applicationName="/FWBO" type="System.Provider.FWRoleProvider"/>
      </providers>
    </roleManager>-->
    <roleManager defaultProvider="FWRoleProvider" enabled="true" cacheRolesInCookie="false" createPersistentCookie="false">
      <providers>
        <clear/>
        <add name="FWRoleProvider" connectionStringName="FWConnectionString" applicationName="/FWBO" type="System.Provider.FWRoleProvider"/>
      </providers>
    </roleManager>
    <identity impersonate="false"/>
  </system.web>
  <microsoft.web>
    <scripting>
      <webServices/>
    </scripting>
  </microsoft.web>
  <system.webServer>
    <handlers>
      <remove name="WebServiceHandlerFactory-ISAPI-2.0"/>
    </handlers>
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll"/>
      <dynamicTypes>
        <add mimeType="text/*" enabled="false"/>
        <add mimeType="message/*" enabled="false"/>
        <add mimeType="application/javascript" enabled="false"/>
        <add mimeType="*/*" enabled="false"/>
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="false"/>
        <add mimeType="message/*" enabled="false"/>
        <add mimeType="application/javascript" enabled="false"/>
        <add mimeType="*/*" enabled="false"/>
      </staticTypes>
    </httpCompression>
    <urlCompression doStaticCompression="false" doDynamicCompression="false"/>
  </system.webServer>
</configuration>